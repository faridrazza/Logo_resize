# ---------- server ----------
APP_NAME=Logo Resize Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ---------- output geometry ----------
TARGET_SIZE=300
# auto | transparent | white
OUTPUT_BACKGROUND=auto
ALLOW_UPSCALE=true
# keep false: trimming changes the logo's framing
TRIM_BORDER=false
TRIM_TOLERANCE=8
MAX_UPLOAD_MB=25

# ---------- processing mode: exact | ai | hybrid ----------
DEFAULT_MODE=hybrid

# ---------- image model ----------
OPENAI_API_KEY=sk-your-key-here
# optional: gateway / proxy base url
OPENAI_BASE_URL=
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_WORK_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_INPUT_FIDELITY=high
REQUEST_TIMEOUT=180
MODEL_MAX_RETRIES=3
PROMPT_FILE=prompt.txt

# ---------- fidelity gate ----------
VERIFY_PHASH_MAX=6
VERIFY_SSIM_MIN=0.93
VERIFY_PIXEL_DIFF_MAX=0.04
VERIFY_COLOR_DELTA_MAX=12

# ---------- storage ----------
INPUT_DIR=data/input
OUTPUT_DIR=data/output
SAVE_OUTPUT=true
