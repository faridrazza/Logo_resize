# ---------- server ----------
APP_NAME=Logo Resize Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ---------- output geometry: Logo Squaring Rules, 2026-09-19 ----------
# EDGE = clamp(max(width, height), EDGE_MIN, EDGE_MAX). Never a fixed size.
EDGE_MIN=128
EDGE_MAX=1200
# "square to within about 5 percent, not to the pixel"
SQUARE_TOLERANCE=0.05
# The only two plate colours. No brand-colour matching.
BG_LIGHT=#ffffff
BG_DARK=#0d0d0d
# Google's file ceiling for the logo asset
MAX_OUTPUT_MB=5
MAX_UPLOAD_MB=25
# keep false: trimming changes the logo's framing
TRIM_BORDER=false
TRIM_TOLERANCE=8

# ---------- processing mode: exact | ai | hybrid ----------
DEFAULT_MODE=hybrid

# ---------- image model ----------
OPENAI_API_KEY=sk-your-key-here
# optional: gateway / proxy base url
OPENAI_BASE_URL=
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_WORK_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_INPUT_FIDELITY=high
# the renderer gets 30s before it counts as unreachable
UPSTREAM_TIMEOUT=30
# plain downloads keep their own budget
REQUEST_TIMEOUT=45
MODEL_MAX_RETRIES=3
PROMPT_FILE=prompt.txt
# paste the source artwork back over its own rectangle after the model renders
COMPOSITE_SOURCE=true

# ---------- fidelity metrics (reported; the artwork is guaranteed by construction) ----------
VERIFY_PHASH_MAX=6
VERIFY_SSIM_MIN=0.93
VERIFY_PIXEL_DIFF_MAX=0.04
VERIFY_COLOR_DELTA_MAX=12

# ---------- storage ----------
INPUT_DIR=data/input
OUTPUT_DIR=data/output
SAVE_OUTPUT=true
